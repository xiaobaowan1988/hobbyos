# ===================================================================
# Makefile — HobbyOS 构建脚本
#
# 使用 aarch64-linux-gnu 交叉编译工具链,
# 将内核编译为可在 QEMU virt 平台运行的裸机 ELF 映像。
#
# 参考文档:
#   [GNU-MAKE] GNU Make 手册
#   [GCC-ARM]  GCC AArch64 Options
# ===================================================================

# -------------------------------------------------------------------
# 交叉编译器前缀
# aarch64-linux-gnu- 是标准的 ARM64 Linux 交叉编译工具链前缀。
# 如果使用其他工具链 (如 aarch64-none-elf-), 修改此变量即可。
# 参考: [GCC-ARM] "AArch64 Options"
# -------------------------------------------------------------------
CROSS   := aarch64-linux-gnu-

# -------------------------------------------------------------------
# 工具链命令定义
# CC  — C 编译器
# AS  — 汇编器 (实际使用 gcc 驱动, 以获得预处理能力)
# LD  — 链接器
# OBJCOPY — 二进制格式转换工具 (ELF → raw binary)
# -------------------------------------------------------------------
CC      := $(CROSS)gcc
LD      := $(CROSS)ld
OBJCOPY := $(CROSS)objcopy

# -------------------------------------------------------------------
# C 编译器标志
#
# -Wall           — 开启所有常见警告
#                   参考: [GCC] "3.8 Options to Request or Suppress Warnings"
# -O2             — 优化等级 2 (性能优化, 不影响调试太多)
#                   参考: [GCC] "3.11 Options That Control Optimization"
# -ffreestanding  — 独立环境: 不链接标准库, 不假设 main() 存在
#                   参考: [GCC] "3.4 Options Controlling C Dialect"
# -nostdlib       — 不链接标准启动文件和标准库
#                   参考: [GCC] "3.15 Options for Linking"
# -nostartfiles   — 不使用标准启动文件 (crt0.o 等)
# -Iinclude       — 头文件搜索路径: include/ 目录
#                   参考: [GCC] "3.16 Options for Directory Search"
# -mcpu=cortex-a72 — 目标 CPU 为 Cortex-A72 (QEMU virt 默认 CPU)
#                   参考: [GCC-ARM] "-mcpu=name"
# -------------------------------------------------------------------
CFLAGS  := -Wall -O2 -ffreestanding -nostdlib -nostartfiles \
           -Iinclude -mcpu=cortex-a72

# -------------------------------------------------------------------
# 链接器标志
#
# -T scripts/linker.ld — 使用自定义链接脚本
#                         参考: [LD-MANUAL] "2.1 Command-line Options"
# -nostdlib             — 不链接标准库
# -------------------------------------------------------------------
LDFLAGS := -T scripts/linker.ld -nostdlib

# -------------------------------------------------------------------
# 源文件与目标文件
#
# ASM_SRC — 汇编源文件列表
# C_SRC   — C 源文件列表
# OBJ     — 所有目标文件 (从源文件自动推导)
# -------------------------------------------------------------------
ASM_SRC := boot/start.S \
           boot/vectors.S
C_SRC   := kernel/main.c \
           kernel/exception.c \
           kernel/pmm.c \
           drivers/uart.c
OBJ     := $(ASM_SRC:.S=.o) $(C_SRC:.c=.o)

# -------------------------------------------------------------------
# 输出文件名
# kernel.elf — ELF 格式的内核映像 (可直接被 QEMU -kernel 加载)
# -------------------------------------------------------------------
TARGET  := kernel.elf

# -------------------------------------------------------------------
# 默认目标: 构建 ELF 内核映像
# -------------------------------------------------------------------
all: $(TARGET)

# -------------------------------------------------------------------
# 链接: 将所有 .o 文件链接为 ELF 可执行文件
#
# $@ — 目标文件名 (kernel.elf)
# $^ — 所有依赖文件 (*.o 列表)
#
# 注意: boot/start.o 必须作为第一个输入文件,
# 这样链接器才会把 .text.boot 段放在最前面。
# 参考: [LD-MANUAL] "3.6 SECTIONS Command"
# -------------------------------------------------------------------
$(TARGET): $(OBJ)
	$(LD) $(LDFLAGS) -o $@ $^

# -------------------------------------------------------------------
# 编译汇编文件 (.S → .o)
#
# -c     — 只编译, 不链接
# $<     — 第一个依赖文件 (源文件)
# $@     — 目标文件
#
# 使用 gcc (而非 as) 编译 .S 文件, 以支持 C 预处理器指令 (#include, #define)。
# 参考: [GCC] "3.2 Options Controlling the Kind of Output"
# -------------------------------------------------------------------
%.o: %.S
	$(CC) $(CFLAGS) -c $< -o $@

# -------------------------------------------------------------------
# 编译 C 文件 (.c → .o)
#
# -c     — 只编译, 不链接
# $<     — 第一个依赖文件 (源文件)
# $@     — 目标文件
# 参考: [GCC] "3.2 Options Controlling the Kind of Output"
# -------------------------------------------------------------------
%.o: %.c
	$(CC) $(CFLAGS) -c $< -o $@

# -------------------------------------------------------------------
# QEMU 运行命令 (便捷目标)
#
# -M virt         — 使用 virt 机器模型
# -cpu cortex-a72 — CPU 类型
# -m 512M         — 内存大小
# -nographic      — 无图形窗口, UART 输出到终端
# -kernel         — 指定内核映像文件
#
# 参考: [QEMU-VIRT] QEMU ARM virt platform documentation
# -------------------------------------------------------------------
run: $(TARGET)
	qemu-system-aarch64 -M virt -cpu cortex-a72 -m 512M \
	    -nographic -kernel $(TARGET)

# -------------------------------------------------------------------
# 清理目标: 删除所有生成的文件
# -------------------------------------------------------------------
clean:
	rm -f $(OBJ) $(TARGET)

# -------------------------------------------------------------------
# 声明伪目标 (这些目标不对应实际文件)
# 参考: [GNU-MAKE] "4.6 Phony Targets"
# -------------------------------------------------------------------
.PHONY: all run clean
